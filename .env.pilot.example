# Temiz pilot demo — bu dosyayı .env.pilot olarak kopyala ve doldur.
# .env.pilot git’e eklenmez. Gerçek TRIKOMEX verisi kullanılmaz.

POSTGRES_USER=velora
POSTGRES_PASSWORD=
POSTGRES_DB=velora_pilot
JWT_SECRET=
JWT_EXPIRES_IN=8h
PILOT_HTTP_PORT=8080

# İlk giriş admin (seed profili) — en az 12 karakter
PILOT_ADMIN_PASSWORD=

# Aynı origin nginx proxy kullanıyorsa boş bırakılabilir
CORS_ORIGIN=

DZD_PER_USD=240
EXCHANGE_RATE_API_URL=
EXCHANGE_RATE_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
