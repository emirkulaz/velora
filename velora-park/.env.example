# --- PostgreSQL (Docker Compose) ---
POSTGRES_USER=velorapark
POSTGRES_PASSWORD=velorapark
POSTGRES_DB=velora_park
POSTGRES_PORT=5433

# --- API (apps/api) ---
NODE_ENV=development
API_PORT=3001
API_PREFIX=api/v1
DATABASE_URL=postgresql://velorapark:velorapark@localhost:5433/velora_park?schema=public
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5174
RECOGNITION_SERVICE_URL=http://localhost:8001
RECOGNITION_INGEST_TOKEN=dev-recognition-token
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
UPLOAD_MAX_BYTES=10485760
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Seed (development only)
SEED_ORG_NAME=Demo Parking Co
SEED_ADMIN_EMAIL=admin@demo.park
SEED_ADMIN_PASSWORD=VeloraPark!2026

# --- Web (apps/web) ---
VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_WS_URL=http://localhost:3001

# --- Recognition (apps/recognition) ---
RECOGNITION_ENV=development
RECOGNITION_HOST=0.0.0.0
RECOGNITION_PORT=8001
RECOGNITION_PROVIDER=mock
ALLOW_MOCK_PROVIDER=true
API_CALLBACK_BASE_URL=http://localhost:3001/api/v1
DEFAULT_COUNTRY_PROFILE=DZ
YOLO_MODEL_PATH=
OCR_PROVIDER=mock

# --- Optional MinIO (docker compose --profile storage) ---
MINIO_ROOT_USER=velorapark
MINIO_ROOT_PASSWORD=velorapark_secret
